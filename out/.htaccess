# Connected2Country — Apache config for cPanel
RewriteEngine On

# Force HTTPS and non-www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://connected2country.au%{REQUEST_URI} [L,R=301]

# Redirect /page.html -> /page/ style not needed (folder URLs); trailing slash on directories
DirectoryIndex index.html index.php
Options -Indexes

# Security headers
<IfModule mod_headers.c>
Header set X-Content-Type-Options "nosniff"
Header set X-Frame-Options "SAMEORIGIN"
Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Caching
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 30 days"
ExpiresByType image/png "access plus 180 days"
ExpiresByType text/html "access plus 1 hour"
</IfModule>

# Compression
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain application/json application/xml
</IfModule>

ErrorDocument 404 /404.html
